# PostgreSQL
POSTGRES_USER=ingest
POSTGRES_PASSWORD=ingest_secret
POSTGRES_DB=ingestion
DATABASE_URL=postgresql+asyncpg://ingest:ingest_secret@localhost:5432/ingestion
DATABASE_URL_SYNC=postgresql+psycopg2://ingest:ingest_secret@localhost:5432/ingestion

# Celery
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/0
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=hybrid_ingestion

# MinIO (S3-compatible)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ingestion-raw
S3_REGION=us-east-1
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Auth
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_ALGORITHM=HS256

# Unstructured PDF parsing
UNSTRUCTURED_STRATEGY=fast
UNSTRUCTURED_INFER_TABLES=false

# Embedder retry jitter bound (seconds)
EMBEDDER_RATE_LIMIT_JITTER=1.0
